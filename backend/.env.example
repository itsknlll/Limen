# Copie para .env (o .env não vai para o git).
# USUARIO e SENHA: os de POSTGRES_USER e POSTGRES_PASSWORD no docker-compose.yml.
AMBIENTE=desenvolvimento
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5433/limen
DATABASE_URL_TESTE=postgresql+psycopg://USUARIO:SENHA@localhost:5433/limen_teste
# Gere um valor com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEGREDO_SESSAO=troque-por-um-valor-aleatorio

# --- OAuth com Google --------------------------------------------------------
# Caminho absoluto para o client_secret.json baixado do Google Cloud Console
# (Credenciais → OAuth 2.0 → tipo "Aplicativo da Web"). O arquivo fica FORA do
# repositório; nunca copie client_id ou client_secret diretamente aqui.
GOOGLE_CLIENT_SECRET_FILE=/caminho/para/client_secret.json

# URI de redirecionamento cadastrada no Google Cloud Console.
# Em desenvolvimento use http://localhost:8080/api/oauth/google/callback
# e suba o uvicorn com: uvicorn app.main:app --reload --port 8080
GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback

# --- Conta Google Ads (não são segredos: IDs públicos) -----------------------
# customer_id: conta cliente de teste (10 dígitos, sem hífens). Troque pelo seu.
GOOGLE_CUSTOMER_ID=0000000000
# login_customer_id: MCC (conta gerenciadora, 10 dígitos, sem hífens). Troque pelo seu.
GOOGLE_LOGIN_CUSTOMER_ID=0000000000

# --- Cifragem de tokens ------------------------------------------------------
# Chave Fernet (AES-128-CBC + HMAC-SHA256) para cifrar o refresh token no banco.
# Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ausente → a aplicação recusa qualquer operação de cifragem/decifragem com mensagem clara.
CHAVE_CIFRAGEM=troque-por-um-valor-gerado-com-o-comando-acima
